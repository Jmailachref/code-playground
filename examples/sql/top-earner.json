{
  "slug": "top-earner",
  "title": "Top earner per department",
  "language": "sql",
  "level": 3,
  "statement": "Table employees(id, name, department, salary).\n\nFor each department, return department, name and salary of the employee with the highest salary. If several people share the top salary, return all of them. Sort by department, then by name.",
